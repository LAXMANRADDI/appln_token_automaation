# Copy this file to .env and fill in real values before running.

# --- Postgres (docker-compose sets this automatically for the app container) ---
DATABASE_URL=postgresql+asyncpg://tokenapp:tokenapp@db:5432/tokenapp

# --- OAuth2 client_credentials provider (the third-party API you're getting tokens from) ---
OAUTH_TOKEN_URL=https://example.com/oauth/token
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_SCOPE=

# --- The API you actually want to call using the fetched token ---
EXTERNAL_API_BASE_URL=https://example.com/api

# --- Refresh tuning ---
# Refresh this many seconds before the token would actually expire
TOKEN_REFRESH_MARGIN_SECONDS=60
# How often (seconds) the background job checks if a refresh is due
POLL_INTERVAL_SECONDS=30

APP_NAME=Token Automation Service
LOG_LEVEL=INFO
